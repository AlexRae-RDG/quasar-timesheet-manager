{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QUASAR Timesheet Manager",
  "version": "2.2.0",
  "identifier": "com.quasartimesheetmanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QUASAR Timesheet Manager",
        "width": 1240,
        "height": 780,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5MTRDQkRDNTRCNkI4NTQKUldSVXVMWlUzTXNVR1NzSzRrMExVQUVQdnRyb0Y1WjRhdWZOeWNIRTVSdVdRdldjZm16QXpIRC8K",
      "endpoints": [
        "https://github.com/AlexRae-RDG/quasar-timesheet-manager/releases/latest/download/latest.json"
      ]
    }
  }
}
